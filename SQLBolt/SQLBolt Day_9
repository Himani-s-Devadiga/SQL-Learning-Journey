/*
===========================================
SQLBolt Lesson 6
Topic: INNER JOIN
===========================================
*/

-- Find movie titles and ratings

SELECT
    movies.title,
    boxoffice.rating
FROM movies
INNER JOIN boxoffice
ON movies.id = boxoffice.movie_id;

----------------------------------------------------

-- Find domestic and international sales

SELECT
    movies.title,
    boxoffice.domestic_sales,
    boxoffice.international_sales
FROM movies
INNER JOIN boxoffice
ON movies.id = boxoffice.movie_id;

----------------------------------------------------

-- Movies that earned more internationally

SELECT
    movies.title,
    boxoffice.domestic_sales,
    boxoffice.international_sales
FROM movies
INNER JOIN boxoffice
ON movies.id = boxoffice.movie_id
WHERE international_sales > domestic_sales;

----------------------------------------------------

-- Movies ordered by ratings

SELECT
    movies.title,
    boxoffice.rating
FROM movies
INNER JOIN boxoffice
ON movies.id = boxoffice.movie_id
ORDER BY rating DESC;

/*
===========================================
SQLBolt Lesson 7
Topic: LEFT JOIN
===========================================
*/

-- Buildings having employees

SELECT DISTINCT building
FROM employees;

----------------------------------------------------

-- Buildings and capacities

SELECT *
FROM buildings;

----------------------------------------------------

-- Buildings and employee roles

SELECT DISTINCT
    buildings.building_name,
    employees.role
FROM buildings
LEFT JOIN employees
ON buildings.building_name = employees.building;

/*
===========================================
SQLBolt Lesson 8
Topic: NULL Values
===========================================
*/

-- Employees without buildings

SELECT
    name,
    role
FROM employees
WHERE building IS NULL;

----------------------------------------------------

-- Buildings without employees

SELECT
    buildings.building_name
FROM buildings
LEFT JOIN employees
ON buildings.building_name = employees.building
WHERE employees.building IS NULL;
