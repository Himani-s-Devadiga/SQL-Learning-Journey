-- =========================================
-- SAMPLE TABLE
-- =========================================

CREATE TABLE employees (
    employee_id INT,
    employee_name VARCHAR(50),
    department VARCHAR(50),
    age INT,
    salary DECIMAL(10,2)
);

INSERT INTO employees
VALUES
(1, 'Himani', 'Data Science', 21, 50000),
(2, 'Navami', 'Cybersecurity', 22, 45000),
(3, 'Jayashree', 'Software', 23, 60000),
(4, 'Shivaprakash', 'Electronics', 25, 55000),
(5, 'Rahul', 'Data Science', 24, 40000);

-- =========================================
-- OPERATORS
-- =========================================

🔥 Now YOU practice

Q1
Find employees whose salary is between 45000 and 55000.
SELECT * FROM employees
WHERE salary BETWEEN 45000 AND 55000;

Q2
Find employees who are older than 21 AND earn more than 50000.
SELECT*FROM employees
WHERE age>21 AND salary>50000;

Q3
Find employees who are in Data Science OR Software.
SELECT * FROM employees
WHERE department='Data Science' OR 
department='Software';

Q4
Display all unique departments.
SELECT DISTINCT department
FROM employees;

Q5
Find employees whose department is either:
Cybersecurity
Software
Electronics
SELECT *
FROM employees
WHERE department IN('CyberSecurity','Software','Electronics');

Q6
Find employees who are NOT in Data Science or Software.
SELECT*FROM employees
WHERE department NOT IN ('Data Science','Software');

-- =========================================
-- AGGREGATE FUNCTIONS
-- =========================================

Q7
Find the maximum salary.
SELECT MAX(salary)
FROM  employees;

Q8
Find the minimum salary.
SELECT MIN(salary)
FROM  employees;

Q9
Find the average salary.
SELECT AVG(salary)
FROM  employees;

Q10
Find the total salary.
SELECT SUM(salary)
FROM  employees;

Q11
Count the number of employees.
SELECT COUNT(*)
FROM  employees;

Q12
Calculate the variance of salary.
SELECT VARIANCE(salary)
FROM  employees;

Q13
Calculate:
ABS(-100)
SELECT ABS(-100);

Q14
Round:
45.6789
to 2 decimal places.
SELECT ROUND(45.6789,2);

Q15
Ceil:
45.2
SELECT CEIL(45.2);

-- =========================================
   MORE TO KNOW
-- =========================================
.

 VAR_POP() → Calculates population variance — variance using the entire population.
 VAR_SAMP() → Calculates sample variance — variance using a sample of the population.

Simple difference
VAR_POP()  → Entire population
VAR_SAMP() → Sample from population

Syntax:
SELECT VAR_POP(salary)
FROM employees;
SELECT VAR_SAMP(salary)
FROM employees;

🧠 Easy memory:
POP = Population 👥
SAMP = Sample 🔬
